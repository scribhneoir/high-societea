---
/** Cycles the page through auto → light → dark → auto.
 *
 *  "Auto" is the absence of a choice rather than a third theme: with no
 *  `data-theme` on <html> the stylesheet follows prefers-color-scheme, which is
 *  why picking it clears the stored value instead of writing one. That also
 *  makes it the state a first-time reader lands in.
 *
 *  Which of the three labels shows is decided in CSS from that same attribute,
 *  not by script on load — the button then reads correctly in the same paint as
 *  the colours it describes, with no flash of the wrong word. */
---

<button class="theme-toggle" type="button" data-theme-toggle>
	<span class="sr-only">Theme:</span>

	<span class="theme-toggle__icon" aria-hidden="true">
		{/* Auto — a disc half in shadow. */}
		<svg data-when="auto" viewBox="0 0 16 16" width="16" height="16" fill="none">
			<circle cx="8" cy="8" r="5.25" stroke="currentColor" stroke-width="1.3"></circle>
			<path d="M8 2.75a5.25 5.25 0 0 1 0 10.5z" fill="currentColor"></path>
		</svg>

		{/* Light — a sun. */}
		<svg
			data-when="light"
			viewBox="0 0 16 16"
			width="16"
			height="16"
			fill="none"
			stroke="currentColor"
			stroke-width="1.3"
			stroke-linecap="round"
		>
			<circle cx="8" cy="8" r="3.1"></circle>
			<path
				d="M8 .9v1.8M8 13.3v1.8M15.1 8h-1.8M2.7 8H.9M13.02 13.02l-1.27-1.27M4.25 4.25 2.98 2.98M13.02 2.98l-1.27 1.27M4.25 11.75l-1.27 1.27"
			></path>
		</svg>

		{/* Dark — a crescent. */}
		<svg data-when="dark" viewBox="0 0 16 16" width="16" height="16" fill="none">
			<path
				d="M13.4 9.86A5.9 5.9 0 0 1 6.14 2.6a5.9 5.9 0 1 0 7.26 7.26z"
				fill="currentColor"></path>
		</svg>
	</span>

	<span class="theme-toggle__label">
		<span data-when="auto">Auto</span>
		<span data-when="light">Light</span>
		<span data-when="dark">Dark</span>
	</span>
</button>

<script>
	const KEY = 'theme';
	const CYCLE = ['auto', 'light', 'dark'] as const;
	const root = document.documentElement;

	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const current = root.dataset.theme ?? 'auto';
		const next = CYCLE[(CYCLE.indexOf(current as (typeof CYCLE)[number]) + 1) % CYCLE.length];

		if (next === 'auto') {
			delete root.dataset.theme;
		} else {
			root.dataset.theme = next;
		}

		// Storage throws rather than no-ops in a few privacy modes, and a theme
		// that fails to persist is better than a button that stops working.
		try {
			if (next === 'auto') localStorage.removeItem(KEY);
			else localStorage.setItem(KEY, next);
		} catch {}
	});
</script>

<style>
	/* Fixed rather than set in the page: the chapters run long, and a control
	   that scrolls away is one the reader has to go looking for. Pinned to the
	   same gutter the page is inset by, so it lines up with the text block on
	   narrow screens and sits clear of it on wide ones. */
	.theme-toggle {
		position: fixed;
		z-index: 2;
		top: clamp(1rem, 3vw, 1.75rem);
		right: var(--gutter);

		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 0.75em;

		font-family: var(--font-caps);
		font-size: 0.68rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--ink-muted);

		/* Not fully opaque — the paper grain reads through, so the control sits on
		   the sheet rather than on top of it. */
		background: color-mix(in srgb, var(--surface) 82%, transparent);
		border: 1px solid var(--rule-soft);
		border-radius: 2px;
		cursor: pointer;
		transition:
			color 120ms ease,
			border-color 120ms ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--rule);
	}

	.theme-toggle__icon {
		display: flex;
		width: 16px;
		height: 16px;
	}

	/* The label's three words differ in width; without a floor the button would
	   resize as it cycles and shift under the pointer mid-click. */
	.theme-toggle__label {
		min-width: 3.4em;
		text-align: left;
	}

	/* One of each triple is shown, chosen by the attribute the stylesheet reads
	   for the colours themselves. display: none also keeps the other two out of
	   the accessibility tree, so the button's name is the current state alone. */
	.theme-toggle [data-when] {
		display: none;
	}

	:root:not([data-theme]) .theme-toggle [data-when='auto'],
	:root[data-theme='light'] .theme-toggle [data-when='light'],
	:root[data-theme='dark'] .theme-toggle [data-when='dark'] {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle {
			transition: none;
		}
	}
</style>
